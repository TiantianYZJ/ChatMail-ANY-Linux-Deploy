# This repo is deployed to Linux servers where CRLF breaks shebangs and
# config files. Force LF for the deployment-relevant text file types.
# Do NOT blanket-apply `* text eol=lf` — it corrupts binary files.

# Deployment-critical text types: always LF
*.sh        text eol=lf
*.py        text eol=lf
*.j2        text eol=lf
*.service   text eol=lf
*.f         text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
Dockerfile  text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.txt       text eol=lf

# Everything else: keep as-is (git auto-detects)
* text=auto

# Binary files — never convert line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.pem       binary
*.key       binary
*.deb       binary
*.tar.gz    binary
*.zip       binary
*.eml       binary
